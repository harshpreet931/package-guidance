{
  "id": "colors",
  "ecosystem": "npm",
  "packages": [
    "colors"
  ],
  "versions": "*",
  "status": "superseded",
  "severity": "warn",
  "summary": "Protestware: in Jan 2022 the maintainer published colors 1.4.1 and 1.4.2 (and 1.4.44-liberty-2) with an infinite loop that printed garbage (GHSA-5rqg-jm4f-cqx7). Those versions are gone and latest is 1.4.0, but the same maintainer controls publishing. Avoid it.",
