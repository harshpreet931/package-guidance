    {
      "name": "util.styleText",
      "kind": "native",
      "when": "Node 20.12+ (stable in 22.13 / 23.5)"
    },
    {
      "name": "picocolors",
      "kind": "package",
      "install": "npm install picocolors",
      "when": "tiny, zero-dependency"
    }
  ],
  "guide": "supply-chain-cooldown",
  "tags": [
    "cli",
    "color",
    "protestware"
  ],
  "source": "https://github.com/advisories/GHSA-5rqg-jm4f-cqx7",
