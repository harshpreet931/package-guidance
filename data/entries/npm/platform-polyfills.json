      "when": "atob/btoa, DOMException, performance.now, Array.prototype.sort, Promise"
    }
  ],
  "tags": [
    "polyfill",
    "native"
  ],
  "source": "https://www.npmjs.com/package/abab",
  "last_verified": "2026-11-16"
}
