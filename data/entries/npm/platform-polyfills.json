{
  "id": "platform-polyfills",
  "ecosystem": "npm",
  "packages": [
    "abab",
    "domexception",
    "node-domexception",
    "w3c-hr-time",
    "stable",
    "q"
  ],
  "versions": "*",
  "status": "deprecated",
  "severity": "block",
  "summary": "All of these are deprecated on npm because the platform has the feature built in: atob/btoa, DOMException, performance.now(), stable Array#sort and native Promise.",
