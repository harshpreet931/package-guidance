{
  "id": "tslint",
  "ecosystem": "npm",
  "packages": [
    "tslint"
  ],
  "versions": "*",
  "status": "deprecated",
  "severity": "block",
  "summary": "TSLint was deprecated in favor of ESLint (palantir/tslint#4534), and the repository is archived.",
  "replacements": [
    {
      "name": "typescript-eslint",
      "kind": "package",
      "install": "npm install -D eslint @eslint/js typescript-eslint",
      "when": "with eslint.config.js"
    }
  ],
  "guide": "eslint-flat-config",
  "tags": [
    "lint",
    "typescript"
  ],
  "source": "https://github.com/palantir/tslint/issues/4534",
  "last_verified": "2026-11-16"
}
